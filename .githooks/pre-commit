#!/usr/bin/env bash
# engram/.githooks/pre-commit
#
# Local pre-commit guard for the engram repo. Two responsibilities:
#   1. Run the personal-data linter over staged files and abort the commit
#      on any leak (workspace paths, reserved agentIds, chatIds, bot tokens).
#   2. Rebuild hook handler bundles (handler.ts -> handler.js) so the gateway
#      can import them at runtime. The commit is aborted if a bundle is
#      stale (i.e. a handler.ts is staged but handler.js is not updated).
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Why: the repo is public. Hardcoded paths, agentIds, chatIds, or bot tokens
# in tests, fixtures, or sample configs are PII / workspace-specific data
# that should never leave the author's machine. Hook bundles must stay in
# sync with their TypeScript sources so a fresh checkout works without a
# build step.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: 'bun' not on PATH; cannot continue." >&2
  echo "         Install bun (https://bun.sh) or commit --no-verify." >&2
  exit 1
fi

# --- 1) Personal-data linter -----------------------------------------------
LINTER="${REPO_ROOT}/scripts/lint-no-personal-data.ts"
if [ -f "$LINTER" ]; then
  echo "pre-commit: running lint-no-personal-data on staged files…"
  if ! bun "$LINTER"; then
    cat >&2 <<'EOF'

Personal-data linter failed. Your staged files contain patterns that look
like local filesystem paths, reserved agentIds, Telegram chatIds, or bot
tokens. None of those belong in the public engram repo.

What to do:
  1. Read the linter output above — it shows the file:line and pattern.
  2. Replace the leaked value with a synthetic placeholder
     (e.g. "/workspaces/alpha", agent id "alpha", chat id "-1001").
  3. Re-stage and try the commit again.

To skip this check (NOT recommended):
  git commit --no-verify
EOF
    exit 1
  fi
fi

# --- 2) Hook bundle rebuild ------------------------------------------------
# Rebuild handler.js for any hook whose handler.ts is staged (or whose
# handler.js is already staged / out of date relative to its source). If
# the build is needed but no changes are produced, the commit still
# proceeds — bun build is deterministic.
BUILDER="${REPO_ROOT}/scripts/build-hook-bundles.ts"
if [ -f "$BUILDER" ]; then
  staged_ts=$(git diff --cached --name-only -- 'hooks/*/handler.ts' || true)
  if [ -n "$staged_ts" ]; then
    echo "pre-commit: rebuilding hook bundles (staged: $staged_ts)…"
    bun "$BUILDER"
    # Add freshly-built bundles to the index so the commit captures them.
    for f in $staged_ts; do
      dir=$(dirname "$f")
      js="$dir/handler.js"
      if [ -f "$js" ]; then
        git add -- "$js"
      fi
    done
  fi
fi
