.planning/
CLAUDE.md
docs
.claude

# Operational state for live heartbeat runs. Not source — contains
# full filesystem paths and per-machine data. Workspace/memory-state/
# is still tracked (only the fact-hashes.json file inside it).
workspace/ops/

# Local backups and runtime artifacts — never source.
*.bak-*
scripts/hb-runner-output.json
scripts/spawn-claim-output.json
# Per-test temp workspaces created by bun test (e.g. ws-bootstrap-test/, ws1/, ws3/, ws5/).
# Each test file's beforeEach mkdtempSync() drops a new directory here.
.tmp/

# Workspace-specific hooks — deployed locally via install-hooks.js, not committed.
# Pattern uses the unique hook suffix (`-peer-domain-load`), not the agent-id
# prefix, so a hook directory like `apriori-peer-domain-load/` can live in the
# skill tree as a workspace-only artifact without being tracked.
hooks/*-peer-domain-load
