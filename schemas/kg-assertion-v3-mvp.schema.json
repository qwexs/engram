{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwexs.dev/engram/schemas/kg-assertion-v3-mvp.schema.json",
  "title": "Engram KG assertion v3 MVP",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "workspaceId", "entityId", "entityType", "kind", "predicate", "object", "scope", "lifecycle", "provenance", "createdAt"],
  "properties": {
    "schema": { "const": "engram.kg-assertion.v3-mvp" },
    "id": { "type": "string", "format": "uuid" },
    "workspaceId": { "$ref": "#/$defs/token" },
    "entityId": { "$ref": "#/$defs/entityId" },
    "entityType": { "$ref": "#/$defs/token" },
    "kind": { "enum": ["identity", "preference", "decision", "constraint"] },
    "predicate": { "$ref": "#/$defs/token" },
    "object": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "string" }, "value": { "type": "string", "minLength": 1, "maxLength": 4096 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "number" }, "value": { "type": "number" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "boolean" }, "value": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "entity-ref" }, "value": { "$ref": "#/$defs/entityId" } } }
      ]
    },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "replacesId", "supersededById", "changedAt"],
      "properties": {
        "status": { "enum": ["active", "superseded", "retracted"] },
        "replacesId": { "type": ["string", "null"], "format": "uuid" },
        "supersededById": { "type": ["string", "null"], "format": "uuid" },
        "changedAt": { "type": "string", "format": "date-time" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceKind", "sessionKey", "messageId", "actorId", "operationId", "observedAt"],
      "properties": {
        "sourceKind": { "enum": ["user_message", "operator-curated"] },
        "sessionKey": { "$ref": "#/$defs/nonEmpty" },
        "messageId": { "$ref": "#/$defs/nonEmpty" },
        "actorId": { "$ref": "#/$defs/nonEmpty" },
        "operationId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 512 },
    "token": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "entityId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)+$", "maxLength": 300 }
  }
}
