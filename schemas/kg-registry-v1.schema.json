{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwexs.dev/engram/schemas/kg-registry-v1.schema.json",
  "title": "Engram KG v3 declarative registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workspaceId", "revision", "entities"],
  "properties": {
    "schema": { "const": "engram.kg-v3-registry.v1" },
    "workspaceId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "entities": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "scopes", "predicates"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "type": { "type": "string", "minLength": 1 },
          "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "predicates": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "kinds", "objectTypes"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["identity", "preference", "decision", "constraint"] } },
                "objectTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["string", "number", "boolean", "entity-ref"] } }
              }
            }
          }
        }
      }
    }
  }
}